{
    "name": "staatzstreich/vela-php",
    "description": "Feasibility spike: porting the vela SFTP TUI client (Rust/ratatui) to PHP using php-tui.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "php-tui/php-tui": "^0.2.1",
        "internal/toml": "^1.1",
        "phpseclib/phpseclib": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Vela\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vela\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "cweagans/composer-patches": "^1.7",
        "humbug/box": "^4.7",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "phar": "box compile",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "patches": {
            "php-tui/term": {
                "Fix sticky $more flag in EventParser::advance() that can strand a trailing lone ESC in the buffer indefinitely (https://github.com/php-tui/term/blob/main/src/EventParser.php) - see patches/README.md": "patches/php-tui-term-event-parser-more-flag.patch",
                "Batch AnsiPainter::paint() into one write() per frame instead of one per queued action, cutting per-frame syscall count from potentially thousands to one - see patches/README.md": "patches/php-tui-term-ansipainter-buffered-write.patch"
            }
        }
    }
}
